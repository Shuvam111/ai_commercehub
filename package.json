{
  "name": "ai-commercehub",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/admin",
    "apps/storefront",
    "packages/shared"
  ],
  "scripts": {
    "dev:admin": "npm run dev --workspace=@ai-commercehub/admin",
    "dev:storefront": "npm run dev --workspace=@ai-commercehub/storefront",
    "build:admin": "npm run build --workspace=@ai-commercehub/admin",
    "build:storefront": "npm run build --workspace=@ai-commercehub/storefront",
    "lint": "eslint apps/admin apps/storefront packages/shared"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
